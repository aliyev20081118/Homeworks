    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x, N, M, &#399;, A" type="Real" array="False" size=""/>
            <input variable="N"/>
            <assign variable="x" expression="N/6"/>
            <assign variable="M" expression="x"/>
