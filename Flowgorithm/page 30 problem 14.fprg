    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a1, a2, d, an, n" type="Real" array="False" size=""/>
            <input variable="a1"/>
            <input variable="a2"/>
            <input variable="n"/>
            <assign variable="d" expression="a2-a1"/>
            <assign variable="an" expression="a1+(n-1)*d"/>
        </body>
    </function>
</flowgorithm>
