    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="d" type="Real" array="False" size=""/>
            <declare name="x1" type="Real" array="False" size=""/>
            <declare name="x2" type="Real" array="False" size=""/>
            <declare name="y1" type="Real" array="False" size=""/>
            <declare name="y2" type="Real" array="False" size=""/>
            <input variable="x1"/>
            <input variable="x2"/>
            <input variable="y1"/>
            <input variable="y2"/>
            <assign variable="d" expression="((x2-x1)^2+(y2-y1)^2)^0.5"/>
