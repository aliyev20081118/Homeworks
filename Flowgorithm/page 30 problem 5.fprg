    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="s" type="Real" array="False" size=""/>
            <declare name="r" type="Real" array="False" size=""/>
            <declare name="h" type="Real" array="False" size=""/>
            <declare name="v" type="Integer" array="False" size=""/>
            <input variable="r"/>
            <input variable="h"/>
            <assign variable="s" expression="2*pi*r*(h+r)"/>
            <assign variable="v" expression="pi*r^3"/>
            <output expression="s" newline="True"/>
            <output expression="v" newline="True"/>
        </body>
    </function>
</flowgorithm>
